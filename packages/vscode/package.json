{
  "name": "actorium-vscode",
  "displayName": "Actorium Agent",
  "description": "Agent-native delivery system",
  "version": "0.6.6",
  "publisher": "actorium-ai",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/actorium-ai/workflow-extension.git"
  },
  "bugs": {
    "url": "https://github.com/actorium-ai/workflow-extension/issues"
  },
  "homepage": "https://github.com/actorium-ai/workflow-extension#readme",
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "actorium",
    "ai",
    "coding",
    "agent",
    "pair-programming"
  ],
  "activationEvents": [
    "onView:actorium.navigatorPanel",
    "onUri"
  ],
  "main": "./dist/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "actorium",
          "title": "Actorium",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "actorium": [
        {
          "type": "webview",
          "id": "actorium.navigatorPanel",
          "name": "Actorium"
        }
      ]
    },
    "commands": [
      {
        "command": "actorium.connect",
        "title": "Actorium: Connect"
      },
      {
        "command": "actorium.disconnect",
        "title": "Actorium: Disconnect"
      },
      {
        "command": "actorium.switchWorkspace",
        "title": "Actorium: Switch Workspace"
      },
      {
        "command": "actorium.checkVersion",
        "title": "Actorium: Check for Updates"
      },
      {
        "command": "actorium.showAccountMenu",
        "title": "Actorium: Account"
      },
      {
        "command": "actorium.switchAccount",
        "title": "Actorium: Switch Account"
      },
      {
        "command": "actorium.addAccount",
        "title": "Actorium: Add Account"
      },
      {
        "command": "actorium.reconnectAccount",
        "title": "Actorium: Reconnect"
      },
      {
        "command": "actorium.openWorkspaceFolder",
        "title": "Actorium: Open Workspace Folder"
      },
      {
        "command": "actorium.addRepo",
        "title": "Actorium: Add Repo"
      },
      {
        "command": "actorium.addMcpServer",
        "title": "Actorium: Add MCP Server to Agent"
      }
    ],
    "icons": {
      "actorium-logo": {
        "description": "Actorium logo",
        "default": {
          "fontPath": "media/actorium-icons.woff",
          "fontCharacter": "\\E001"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "pnpm run build && pnpm run bundle",
    "build": "pnpm --filter @workflow-extension/vscode-webview run build && tsc -p tsconfig.json",
    "bundle": "node scripts/bundle-extension.mjs",
    "watch": "tsc -watch -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/test/**/*.test.js",
    "pretest": "pnpm run build",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "lint": "eslint . --fix"
  },
  "dependencies": {
    "@workflow-extension/shared": "workspace:*"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "0.28.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.7.0",
    "svg2ttf": "6.1.0",
    "svgicons2svgfont": "16.0.0",
    "ttf2woff": "3.0.0",
    "typescript": "^5.5.0"
  }
}
